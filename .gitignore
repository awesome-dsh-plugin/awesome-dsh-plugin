node_modules/
.DS_Store
# Editor state, never part of a submission. IntelliJ and PyCharm create .idea/
# the moment the folder is opened, and `git add -A` sweeps it into the PR —
# #1663 committed six of these files before anyone noticed.
.idea/
.vscode/
*.swp
docs/
data/npm-map.json
# data/stars.json is deliberately NOT ignored — see the header of
# scripts/probe-stars.mjs. It is the committed floor that makes "a failed repo
# keeps its old entry" true; while it lived only in the Actions cache, one
# cache miss on a spent API quota published `stars: null` for every entry.
data/readmes.json
data/tarballs.json
# Regenerated by probe-screenshots.mjs on every build, like tarballs.json.
# Deliberately NOT added to the actions/cache path list in build-site.yml:
# that list keys the cache, and extending it forces a cold start for every
# probe at once (#1673). This one costs nothing to rebuild — it hits
# raw.githubusercontent.com, not the API quota the gate depends on.
data/screenshots-declared.json
data/screenshots-live.json

.npm-cache/
